# Twilio — WhatsApp Business API
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenAI — Whisper transcription
OPENAI_API_KEY=sk-...

# Groq — free-tier Whisper transcription, story enhancement, and photo vision
GROQ_API_KEY=gsk_...

# Photo reconstruction (story-from-image pipeline)
# Replicate hosts the open-source models (GFPGAN, Real-ESRGAN, DeOldify).
# Absent → restoration/colorization is skipped; the vision story-seed still runs on Groq.
REPLICATE_API_TOKEN=r8_...
# Groq vision model used to read a photo and draft a story seed + questions.
VISION_MODEL=llama-3.2-90b-vision-preview

# App
DATABASE_URL=sqlite:///smriti.db
WEBHOOK_BASE_URL=https://your-ngrok-or-domain.com
# PORT is optional, defaults to 8000
PORT=8000
