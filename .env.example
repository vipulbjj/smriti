# Twilio — WhatsApp Business API
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenAI — Whisper transcription
OPENAI_API_KEY=sk-...

# Groq — free-tier Whisper transcription, story enhancement, and photo vision
GROQ_API_KEY=gsk_...

# Photo reconstruction (story-from-image pipeline)
# Replicate hosts the open-source models (GFPGAN, Real-ESRGAN, DeOldify).
# Absent → restoration/colorization is skipped; the vision story-seed still runs on Groq.
REPLICATE_API_TOKEN=r8_...
# Groq vision model used to read a photo and draft a story seed + questions.
VISION_MODEL=llama-3.2-90b-vision-preview

# PDF object storage (optional — absent → local /tmp path).
# Set these to persist memoir PDFs off Vercel's ephemeral /tmp and return signed URLs.
# Works with S3 or Cloudflare R2 (set STORAGE_ENDPOINT_URL to the R2 endpoint).
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY use standard AWS env vars
STORAGE_SIGNED_URL_TTL=604800

# Webhook rate limiting (per-phone token bucket)
WEBHOOK_RATE_MAX=10
WEBHOOK_RATE_WINDOW=3600

# App
DATABASE_URL=sqlite:///smriti.db
WEBHOOK_BASE_URL=https://your-ngrok-or-domain.com
# PORT is optional, defaults to 8000
PORT=8000
