{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/send-prompts",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/cron/send-reminders",
      "schedule": "30 3 * * 4"
    },
    {
      "path": "/cron/poll-videos",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/cron/process-pending",
      "schedule": "0 4 * * *"
    }
  ]
}
